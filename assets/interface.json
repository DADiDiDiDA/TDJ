{
    "interface_version": 2,
    "name": "TDJ",
    "description": "",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    "version": "0.1.0",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "天地劫",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        },
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "进入游戏",
            "entry": "返回主界面开始",
            "default_check": true,
            "doc": "自动登录游戏并进入主界面（启动游戏最好在设置里执行，这个不能开启游戏）"
        },
        {
            "name": "领取邮件",
            "entry": "领取邮件开始",
            "default_check": true,
            "doc": "自动领取邮件奖励"
        },
        {
            "name": "赠送友情点",
            "entry": "赠送友情点开始",
            "default_check": true,
            "doc": "自动向好友赠送友情点（只有同服好友）"
        },
        {
            "name": "山河志派遣",
            "entry": "山河志派遣开始",
            "default_check": true,
            "doc": "自动进行山河志派遣任务"
        },
        {
            "name": "刷体力第一次",
            "entry": "刷体力开始",
            "default_check": true,
            "option": ["选择打什么关卡"],
            "doc": "第一次体力刷取，扫荡（自动选择上限次数）或自动战斗（只能自动打一次）"
        },
        {
            "name": "刷体力第二次",
            "entry": "刷体力开始",
            "default_check": true,
            "option": ["选择打什么关卡"],
            "doc": "第二次体力刷取，消耗体力扫荡或自动战斗"
        },
        {
            "name": "通关文牒奖励",
            "entry": "通关文牒奖励开始",
            "default_check": true,
            "doc": "自动领取通关文牒的奖励"
        },
        {
            "name": "幻境挑战",
            "entry": "幻境挑战开始",
            "default_check": true,
            "doc": "自动进行一次幻境挑战"
        },
        {
            "name": "领取历练奖励",
            "entry": "领取历练奖励开始",
            "default_check": true,
            "doc": "自动领取历练任务的每日奖励"
        }
    ],
    "option": {
        "选择打什么关卡": {
            "type": "select",
            "label": "选择关卡",
            "default": "灵脉光渊",
            "cases": [
                {
                    "name": "灵脉光渊",
                    "label": "灵脉光渊",
                    "option": ["开始灵脉光渊类型选择", "刷取关卡方式选择-灵脉光渊"],
                    "pipeline_override": {
                        "选择打什么关卡": {
                            "next": [
                                "灵脉光渊",
                                "[JumpBack]滑动屏幕进行关卡选择"
                            ]
                        }
                    }
                },
                {
                    "name": "创命之间",
                    "label": "创命之间",
                    "option": ["开始创命之间类型选择", "刷取关卡方式选择-灵脉光渊"],
                    "pipeline_override": {
                        "选择打什么关卡": {
