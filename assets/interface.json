{
    "interface_version": 2,
    "name": "TDJ",
    "label": "天地劫：幽城再临",
    "description": "《天地劫：幽城再临》日常任务自动化",
    "license": "MIT",
    "welcome": "欢迎！只能完成日常任务欧~",
    "version": "1.1.2",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "^.*(天地劫|TDJ).*$",
                "screencap": "PrintWindow",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        },
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "进入游戏",
            "entry": "返回主界面开始",
            "default_check": true,
            "doc": "自动登录游戏（启动游戏最好在设置里执行，这个不能开启游戏）",
            "label": "进入游戏"
        },
        {
            "name": "领取邮件",
            "entry": "领取邮件开始",
            "default_check": true,
            "doc": "自动领取邮件",
            "label": "领取邮件"
        },
        {
            "name": "赠送友情点",
            "entry": "赠送友情点开始",
            "default_check": true,
            "doc": "自动向好友赠送友情点（只有同服好友）",
            "label": "赠送友情点"
        },
        {
            "name": "山河志派遣",
            "entry": "山河志派遣开始",
            "default_check": true,
            "doc": "自动进行山河志派遣",
            "label": "山河志派遣"
        },
        {
            "name": "刷灵脉光渊",
            "entry": "旧世领取开始",
            "default_check": true,
            "option": [
                "刷灵脉光渊-选择属性"
            ],
            "doc": "刷一次灵脉光渊并领取旧世奖励",
            "label": "刷灵脉光渊"
        },
        {
            "name": "刷蚀之隙",
            "entry": "刷蚀之隙开始",
            "default_check": true,
            "doc": "刷一次第一章简单难度的蚀之隙已完成日常任务",
            "label": "刷蚀之隙"
        },
        {
            "name": "刷体力",
            "entry": "刷体力开始",
            "default_check": true,
            "option": [
                "选择打什么关卡"
            ],
            "doc": "消耗体力进行扫荡",
            "label": "刷体力"
        },
        {
            "name": "天地阁加速",
            "entry": "天地阁加速开始",
            "default_check": true,
            "doc": "天地阁加速",
            "label": "天地阁加速"
        },
        {
            "name": "幻境挑战",
            "entry": "幻境挑战开始",
            "default_check": true,
            "doc": "自动进行一次幻境挑战",
            "label": "幻境挑战"
        },
        {
            "name": "每日免费召唤",
            "entry": "每日免费召唤开始",
            "default_check": true,
            "doc": "进行每日免费召唤一次",
            "label": "每日免费召唤"
        },
        {
            "name": "通关文牒奖励",
            "entry": "通关文牒奖励开始",
            "default_check": true,
            "doc": "自动领取通关文牒的奖励",
            "label": "通关文牒奖励"
        },
        {
            "name": "周常处理",
            "entry": "周常处理开始",
            "default_check": true,
            "doc": "自动处理旧世周常、三途川扫荡及周常奖励领取",
            "label": "周常处理"
        },
        {
            "name": "领取历练奖励",
            "entry": "领取历练奖励开始",
            "default_check": true,
            "doc": "自动领取历练任务的每日奖励",
            "label": "领取历练奖励"
        }
    ],
    "option": {
        "刷灵脉光渊-选择属性": {
            "type": "select",
            "label": "灵脉光渊 - 选择属性",
            "default_case": "炎之灵脉",
            "cases": [
                {
                    "name": "炎之灵脉",
                    "label": "炎之灵脉",
                    "pipeline_override": {
                        "开始灵脉光渊类型选择": {
                            "next": [
                                "炎之灵脉"
                            ]
                        }
                    }
                },
                {
                    "name": "冰之灵脉",
                    "label": "冰之灵脉",
                    "pipeline_override": {
                        "开始灵脉光渊类型选择": {
                            "next": [
                                "冰之灵脉"
                            ]
                        }
                    }
                },
                {
                    "name": "雷之灵脉",
                    "label": "雷之灵脉",
                    "pipeline_override": {
                        "开始灵脉光渊类型选择": {
                            "next": [
                                "雷之灵脉"
                            ]
                        }
                    }
                },
                {
                    "name": "光之灵脉",
                    "label": "光之灵脉",
                    "pipeline_override": {
                        "开始灵脉光渊类型选择": {
                            "next": [
                                "光之灵脉"
                            ]
                        }
                    }
                },
                {
                    "name": "暗之灵脉",
                    "label": "暗之灵脉",
                    "pipeline_override": {
                        "开始灵脉光渊类型选择": {
                            "next": [
                                "暗之灵脉"
                            ]
                        }
                    }
                },
                {
                    "name": "幽之灵脉",
                    "label": "幽之灵脉",
                    "pipeline_override": {
                        "开始灵脉光渊类型选择": {
                            "next": [
                                "幽之灵脉"
                            ]
                        }
                    }
                }
            ],
            "description": "选择灵脉光渊 - 选择属性。"
        },
        "选择打什么关卡": {
            "type": "select",
            "label": "选择关卡",
            "default_case": "创命之间",
            "cases": [
                {
                    "name": "创命之间",
                    "label": "创命之间",
