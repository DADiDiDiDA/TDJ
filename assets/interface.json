                {
                    "name": "幻海魂渊",
                    "label": "幻海魂渊",
                    "option": [
                        "刷取关卡方式选择-灵脉光渊"
                    ],
                    "pipeline_override": {
                        "选择打什么关卡": {
                            "next": [
                                "幻海魂渊",
                                "[JumpBack]滑动屏幕进行关卡选择"
                            ]
                        }
                    }
                },
                {
                    "name": "魂海渊祭",
                    "label": "魂海渊祭",
                    "option": [
                        "刷取关卡方式选择-灵脉光渊"
                    ],
                    "pipeline_override": {
                        "选择打什么关卡": {
                            "next": [
                                "魂海渊祭",
                                "[JumpBack]滑动屏幕进行关卡选择"
                            ]
                        }
                    }
                }
            ],
            "description": "选择选择关卡。"
        },
        "开始创命之间类型选择": {
